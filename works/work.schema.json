{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rootlogos.com/works/work.schema.json",
  "title": "Root Logos Living Work",
  "type": "object",
  "required": ["schema", "work_id", "title", "kind", "source_hash", "current_edition", "editions"],
  "properties": {
    "schema": { "const": "root-logos-work/v1" },
    "work_id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "author": { "type": "string" },
    "kind": { "type": "string", "minLength": 1 },
    "source": { "type": ["string", "null"] },
    "source_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "source_retained": { "const": true },
    "translation": { "type": ["string", "null"] },
    "language": { "type": "string", "minLength": 2 },
    "rights": { "type": "string", "minLength": 1 },
    "current_edition": { "type": "string", "minLength": 1 },
    "editions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["edition_id", "root_logos_revision", "created_at", "href"]
      }
    }
  }
}
