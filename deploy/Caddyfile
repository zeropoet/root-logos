runtime.rootlogos.com {
  encode zstd gzip
  reverse_proxy 127.0.0.1:8787
  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "no-referrer"
  }
}

rootlogos.com, www.rootlogos.com {
  encode zstd gzip
  root * /var/www/root-logos
  @agent_browser {
    path /agent.json
    header Accept *text/html*
  }
  rewrite @agent_browser /agent-entry.html
  file_server

  @agent_entry path /agent.json
  header @agent_entry Link "<https://rootlogos.com/assets/root-logos-presence-mark.svg>; rel=\"icon\"; type=\"image/svg+xml\""

  @presence_origin header_regexp Origin ^https://(presence\.rootlogos\.com|presence\.zeropoet\.xyz)$
  header @presence_origin Access-Control-Allow-Origin "{http.request.header.Origin}"
  header @presence_origin Vary "Origin"

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "no-referrer"
  }
}

presence.rootlogos.com, presence.zeropoet.xyz {
  encode zstd gzip

  @presence path /
  handle @presence {
    root * /opt/root-logos
    rewrite * /presence.html
    file_server
  }

  handle {
    redir https://rootlogos.com{uri} permanent
  }

  header {
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
    X-Content-Type-Options "nosniff"
    X-Frame-Options "DENY"
    Referrer-Policy "no-referrer"
  }
}
